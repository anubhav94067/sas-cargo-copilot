# Azure Foundry (CDX hackathon) — preferred
AZURE_OPENAI_ENDPOINT=https://cdx-ai-hackathon-support-crew-foundry.openai.azure.com/
AZURE_OPENAI_API_KEY=paste-key-from-az-cli
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Embeddings deployment (for future RAG / vector search)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Optional public OpenAI fallback (used only if Azure vars are absent)
# OPENAI_API_KEY=sk-...

# Server
PORT=3000

# Governed Foundry prompt agent (preferred when set; uses Entra/az login auth)
FOUNDRY_PROJECT_ENDPOINT=https://cdx-ai-hackathon-support-crew-foundry.services.ai.azure.com/api/projects/proj-default
FOUNDRY_AGENT_NAME=sas-cargo-copilot
FOUNDRY_API_VERSION=2025-05-15-preview

# Contribution calculations — leave URL unset to use the built-in mock engine
# CALCULATIONS_API_URL=
# CALCULATIONS_API_KEY=
# CALC_APPROVAL_MARGIN=0.15

# API key for external callers (Power Automate / Salesforce). Leave unset for open local dev.
# API_KEY=change-me
